<Project>
  <!-- Test projects (xUnit v3, run by `dotnet test` from the repository root): every build and test output goes to
       ~/.nexus/build/nexuskeypad/test (root Directory.Build.props), never into OneDrive. test.ps1 passes the same
       NexusBuild to the plugin builds. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />
  <PropertyGroup>
    <NexusBuild Condition="'$(NexusBuild)' == ''">$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::Combine('$(NexusKeypadBuild)', 'test'))))</NexusBuild>
    <BaseIntermediateOutputPath>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::Combine('$(NexusBuild)', '$(MSBuildProjectName)', 'obj'))))</BaseIntermediateOutputPath>
    <BaseOutputPath>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::Combine('$(NexusBuild)', '$(MSBuildProjectName)', 'bin'))))</BaseOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NexusKeypad.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The recommended .NET analyzers, every warning an error, as the plugin (the StyleCop analyzers of the LogiPluginApi
         package in CI are left out by the root Directory.Build.props). Nullable annotations: the plugin's and hook's sources
         compiled here keep their annotations (checked by their own builds); test code fails on a null by itself. -->
    <Nullable>annotations</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <LogiService>C:\Program Files\Logi\LogiPluginService\</LogiService>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <Using Include="Xunit" />
    <AssemblyMetadata Include="NexusKeypad.Repository" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))" />
    <AssemblyMetadata Include="NexusKeypad.Build" Value="$(NexusBuild)" />
  </ItemGroup>
</Project>
