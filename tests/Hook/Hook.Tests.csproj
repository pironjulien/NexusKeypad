<Project Sdk="Microsoft.NET.Sdk">

  <!-- The native hook nexuskeypad-hook.exe shipped in the plugin package: its rules in-process (hook\*.cs compiled here),
       and the published Native AOT executable itself, run in temporary profiles (states, Codex, update swap). The pad's
       test tool outils\pad.ps1 is checked here too (its reel guard). -->
  <PropertyGroup>
    <Nullable>annotations</Nullable>
    <!-- hook\Program.cs has its own Main: the xUnit entry point is written by hand (Entree.cs). -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <StartupObject>NexusKeypad.Tests.Entree</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\hook\*.cs" Link="Hook\%(Filename)%(Extension)" />
    <Compile Include="..\..\plugin\src\Trinite\Connecteurs.cs" Link="Plugin\Connecteurs.cs" />
    <Compile Include="..\..\plugin\src\Trinite\EtatsEnDirect.cs" Link="Plugin\EtatsEnDirect.cs" />
    <EmbeddedResource Include="..\..\hook\assets\antigravity.wav" LogicalName="NexusKeypad.Hook.antigravity.wav" />
    <EmbeddedResource Include="..\..\hook\assets\claude.wav" LogicalName="NexusKeypad.Hook.claude.wav" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <!-- The published executable, as the plugin build makes it (same folder under NexusBuild, so test.ps1's plugin builds
       and these tests share it). Republished only when its sources change; vswhere (Visual Studio Installer) serves the
       native linker. -->
  <PropertyGroup>
    <HookProjet>$(MSBuildThisFileDirectory)..\..\hook\</HookProjet>
    <HookSortie>$(NexusBuild)hook-build\publish\</HookSortie>
    <PluginTrinite>$(MSBuildThisFileDirectory)..\..\plugin\src\Trinite\</PluginTrinite>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NexusKeypad.Hook" Value="$(HookSortie)nexuskeypad-hook.exe" />
  </ItemGroup>
  <Target Name="HookPublie" BeforeTargets="Build"
          Inputs="$(HookProjet)Program.cs;$(HookProjet)Codex.cs;$(HookProjet)Son.cs;$(HookProjet)assets\antigravity.wav;$(HookProjet)assets\claude.wav;$(HookProjet)PluginLog.cs;$(HookProjet)Touches.cs;$(HookProjet)Echange.cs;$(HookProjet)hook.csproj;$(PluginTrinite)EtatsEnDirect.cs;$(PluginTrinite)Connecteurs.cs"
          Outputs="$(HookSortie)nexuskeypad-hook.exe">
    <Exec Command="set &quot;PATH=$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer;%PATH%&quot; &amp;&amp; dotnet publish &quot;$(HookProjet)hook.csproj&quot; -c Release -nologo -v q -o &quot;$(HookSortie.TrimEnd('\'))&quot;"
          EnvironmentVariables="DOTNET_CLI_TELEMETRY_OPTOUT=1" />
  </Target>

</Project>
