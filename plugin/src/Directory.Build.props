<Project>
    <!-- Compilation hors de OneDrive : obj et bin vont dans ~\.nexus\build\nexuskeypad (hors AppData, que les applis MSIX dédoublent). -->
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <NexusBuild>$(USERPROFILE)\.nexus\build\nexuskeypad\</NexusBuild>
        <BaseIntermediateOutputPath>$(NexusBuild)obj\</BaseIntermediateOutputPath>
    </PropertyGroup>
</Project>
