<Project>
    <!-- Compilation hors de OneDrive : obj et bin vont dans %LOCALAPPDATA%\NexusKeypad. -->
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <NexusBuild>$(LocalAppData)\NexusKeypad\</NexusBuild>
        <BaseIntermediateOutputPath>$(NexusBuild)obj\</BaseIntermediateOutputPath>
    </PropertyGroup>
</Project>
