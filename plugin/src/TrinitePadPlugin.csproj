<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Loupedeck.TrinitePlugin</RootNamespace>

    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <NoWarn>$(NoWarn);SA0001;SA1136;SA1300;SA1307;SA1310;SA1402;SA1407;SA1414;SA1502;SA1649</NoWarn>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <PluginDir>$(LocalAppData)\Logi\LogiPluginService\Plugins\</PluginDir>

    <BaseOutputPath>$(NexusBuild)bin\</BaseOutputPath>
    <!-- Édition du Logi Marketplace (outils\paquet_marketplace.ps1) : page 1 seule, sans tube d'essais, compilée à part. -->
    <BaseOutputPath Condition="'$(Edition)' == 'Marketplace'">$(NexusBuild)marketplace\bin\</BaseOutputPath>
    <DefineConstants Condition="'$(Edition)' == 'Marketplace'">$(DefineConstants);MARKETPLACE</DefineConstants>
    <!-- Sans symboles : ni .pdb ni chemin du poste (dossier de l'utilisateur) gravé dans la DLL distribuée. -->
    <DebugType Condition="'$(Edition)' == 'Marketplace'">none</DebugType>

    <PluginShortName>TrinitePad</PluginShortName>
    <Paquet>package</Paquet>
  </PropertyGroup>

  <!-- Édition « PC Dashboard » (outils\paquet_marketplace.ps1 -Edition Poste) : la page 2 seule, second plugin du Logi
       Marketplace. Un autre plugin pour le service : autre nom (PcDashboard), autre DLL, autre classe de plugin,
       autre dossier de paquet (package-poste : fiche, icône, traduction). -->
  <PropertyGroup Condition="'$(Edition)' == 'Poste'">
    <BaseOutputPath>$(NexusBuild)poste\bin\</BaseOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)poste\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>$(DefineConstants);POSTE</DefineConstants>
    <DebugType>none</DebugType>
    <AssemblyName>PcDashboardPlugin</AssemblyName>
    <PluginShortName>PcDashboard</PluginShortName>
    <Paquet>package-poste</Paquet>
  </PropertyGroup>

  <!-- Édition « AI Coding Agents + PC » (outils\paquet_marketplace.ps1 -Edition Complete) : les deux pages, comme la
       version de Julien, troisième plugin du Logi Marketplace, sans tube d'essais ni réglage du site du poste. -->
  <PropertyGroup Condition="'$(Edition)' == 'Complete'">
    <BaseOutputPath>$(NexusBuild)complete\bin\</BaseOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)complete\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>$(DefineConstants);COMPLETE</DefineConstants>
    <DebugType>none</DebugType>
    <AssemblyName>AiAgentsPcPlugin</AssemblyName>
    <PluginShortName>AiAgentsPc</PluginShortName>
    <Paquet>package-complete</Paquet>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(BaseOutputPath)$(Configuration)\bin\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <LogiService>C:\Program Files\Logi\LogiPluginService\</LogiService>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(LogiService)PluginApi.dll')">
    <!-- API du service installé : une version plus récente que le service est refusée au chargement. -->
    <Reference Include="PluginApi" HintPath="$(LogiService)PluginApi.dll" Private="false" />
    <!-- SkiaSharp du service (2.88.8, déjà chargé par lui) : encodage WebP de la photo collée, rien d'ajouté au paquet. -->
    <Reference Include="SkiaSharp" HintPath="$(LogiService)SkiaSharp.dll" Private="false" />
  </ItemGroup>

  <!-- Sans service Logi (intégration continue) : l'API publiée par Logitech, pour compiler seulement. -->
  <ItemGroup Condition="!Exists('$(LogiService)PluginApi.dll')">
    <PackageReference Include="LogiPluginApi" Version="6.4.2.3567" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyPackage" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <PackageFiles Include="$(Paquet)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(OutputPath)..\%(RecursiveDir)" />
  </Target>

  <!-- test.ps1 compile avec NexusTest=true : ni lien posé, ni rechargement du plugin en service. -->
  <!-- Installé comme un vrai paquet (Plugins\TrinitePad), pas par un lien .link : avec le lien, le service ne chargeait
       pas le plugin quand Logi démarrait avec Windows (pad sur le logo Logi) ; le paquet se charge toujours. -->
  <Target Name="PostBuild" AfterTargets="CopyPackage" Condition="'$(NexusTest)' != 'true'">
    <ItemGroup>
      <Paquet Include="$(BaseOutputPath)$(Configuration)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(Paquet)" DestinationFolder="$(PluginDir)$(PluginShortName)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Delete Files="$(PluginDir)$(ProjectName).link" />
    <!-- Pas d'ordre « reload » : Logi surveille ce dossier et recharge déjà le plugin à la copie ; l'ordre en plus le
         chargeait deux fois (deux moteurs, tube du pilote pris, 23/10). -->
  </Target>

  <Target Name="PluginClean" AfterTargets="CoreClean">
    <Delete Files="$(PluginDir)$(ProjectName).link" Condition="'$(NexusTest)' != 'true'" />
    <RemoveDir Directories="$(PluginDir)$(PluginShortName)\" Condition="'$(NexusTest)' != 'true'" />
    <RemoveDir Directories="$(OutputPath)..\" />
  </Target>

</Project>
