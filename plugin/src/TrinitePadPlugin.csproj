<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.8.7</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Loupedeck.TrinitePlugin</RootNamespace>

    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <NoWarn>$(NoWarn);SA0001;SA1136;SA1300;SA1307;SA1310;SA1402;SA1407;SA1414;SA1502;SA1649</NoWarn>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <PluginDir>$(LocalAppData)\Logi\LogiPluginService\Plugins\</PluginDir>

    <BaseOutputPath>$(NexusBuild)bin\</BaseOutputPath>

    <PluginShortName>TrinitePad</PluginShortName>
    <Paquet>package</Paquet>
  </PropertyGroup>

  <!-- Édition « AI Coding Agents » du Logi Marketplace (outils\paquet_marketplace.ps1) : page 1 seule, sans tube d'essais,
       compilée à part (sorties et fichiers intermédiaires à elle : la compilation d'une autre édition ne s'y mélange pas).
       Sans symboles : ni .pdb ni chemin du poste (dossier de l'utilisateur) gravé dans la DLL distribuée. -->
  <PropertyGroup Condition="'$(Edition)' == 'Marketplace'">
    <BaseOutputPath>$(NexusBuild)marketplace\bin\</BaseOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)marketplace\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>$(DefineConstants);MARKETPLACE</DefineConstants>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Édition « PC Dashboard » (outils\paquet_marketplace.ps1 -Edition Poste) : la page 2 seule, second plugin du Logi
       Marketplace. Un autre plugin pour le service : autre nom (PcDashboard), autre DLL, autre classe de plugin,
       autre dossier de paquet (package-poste : fiche, icône, traduction). -->
  <PropertyGroup Condition="'$(Edition)' == 'Poste'">
    <BaseOutputPath>$(NexusBuild)poste\bin\</BaseOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)poste\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>$(DefineConstants);POSTE</DefineConstants>
    <DebugType>none</DebugType>
    <AssemblyName>PcDashboardPlugin</AssemblyName>
    <PluginShortName>PcDashboard</PluginShortName>
    <Paquet>package-poste</Paquet>
  </PropertyGroup>

  <!-- Édition « AI Coding Agents + PC » (outils\paquet_marketplace.ps1 -Edition Complete) : les deux pages, comme la
       version complète, troisième plugin du Logi Marketplace, sans tube d'essais ni réglage du site du poste. -->
  <!-- Édition complète hors Marketplace (outils\paquet_marketplace.ps1 -Edition Nexus, installée par get.ps1) : tout ce
       que fait la version des sources (deux pages, réglage du site du poste, tube d'essais local), sous son propre nom
       (NexusKeypad) pour qu'Options+ ne la confonde jamais avec une fiche de la Marketplace. -->
  <PropertyGroup Condition="'$(Edition)' == 'Nexus'">
    <BaseOutputPath>$(NexusBuild)nexus\bin\</BaseOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)nexus\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>$(DefineConstants);NEXUS</DefineConstants>
    <DebugType>none</DebugType>
    <AssemblyName>NexusKeypadPlugin</AssemblyName>
    <PluginShortName>NexusKeypad</PluginShortName>
    <Paquet>package-nexus</Paquet>
  </PropertyGroup>

  <!-- PC Dashboard ne compile que ce qui sert au poste : rien qui lise les applis d'IA (audit du 26/10 : un relecteur qui
       décompile ne doit voir que la fonction déclarée). -->
  <ItemGroup Condition="'$(Edition)' == 'Poste'">
    <Compile Remove="Trinite\Etats.Claude.cs;Trinite\Etats.Codex.cs;Trinite\Etats.Antigravity.cs;Trinite\QuotaAntigravity.cs" />
    <Compile Remove="Trinite\Rendu.Personnages.cs;Trinite\ImageIa.cs;Trinite\Js.cs;Trinite\Cdp.cs;Trinite\EtatsEnDirect.cs" />
    <Compile Remove="Trinite\Ecran.cs;Trinite\PressePapiers.cs;Actions\LiveStatesCommand.cs" />
    <Compile Remove="Trinite\NavigationAntigravity.cs" />
    <Compile Remove="Trinite\Connecteurs.cs;Trinite\ConnexionPad.cs;Trinite\Lanceurs.cs;Trinite\Rendu.Connexion.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Edition)' != 'Poste'">
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Edition)' == 'Complete'">
    <BaseOutputPath>$(NexusBuild)complete\bin\</BaseOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)complete\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>$(DefineConstants);COMPLETE</DefineConstants>
    <DebugType>none</DebugType>
    <AssemblyName>AiAgentsPcPlugin</AssemblyName>
    <PluginShortName>AiAgentsPc</PluginShortName>
    <Paquet>package-complete</Paquet>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(BaseOutputPath)$(Configuration)\bin\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <LogiService>C:\Program Files\Logi\LogiPluginService\</LogiService>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(LogiService)PluginApi.dll')">
    <!-- API du service installé : une version plus récente que le service est refusée au chargement. -->
    <Reference Include="PluginApi" HintPath="$(LogiService)PluginApi.dll" Private="false" />
    <!-- SkiaSharp du service (2.88.8, déjà chargé par lui) : encodage WebP de la photo collée, rien d'ajouté au paquet. -->
    <Reference Include="SkiaSharp" HintPath="$(LogiService)SkiaSharp.dll" Private="false" />
  </ItemGroup>

  <!-- Sans service Logi (intégration continue) : l'API publiée par Logitech, pour compiler seulement. -->
  <ItemGroup Condition="!Exists('$(LogiService)PluginApi.dll')">
    <PackageReference Include="LogiPluginApi" Version="6.4.2.3567" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyPackage" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <PackageFiles Include="$(Paquet)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(OutputPath)..\%(RecursiveDir)" />
  </Target>

  <!-- Hook des états en direct (nexuskeypad-hook.exe, natif, sans Python) à côté de la DLL, sauf dans PC Dashboard (pas
       d'agents). Recompilé seulement quand ses sources changent ; vswhere (Visual Studio Installer) sert à l'éditeur de
       liens natif. Le dossier de sortie est passé sans « \ » final : « \" » échappe le guillemet et colle au chemin
       tout argument ajouté après la commande (cas de l'analyse CodeQL, 27/10). -->
  <PropertyGroup>
    <HookProjet>$(MSBuildThisFileDirectory)..\..\hook\</HookProjet>
    <HookSortie>$(NexusBuild)hook-build\publish\</HookSortie>
  </PropertyGroup>
  <Target Name="HookPublie" Inputs="$(HookProjet)Program.cs;$(HookProjet)Codex.cs;$(HookProjet)Son.cs;$(HookProjet)assets\antigravity.wav;$(HookProjet)assets\claude.wav;$(HookProjet)PluginLog.cs;$(HookProjet)Touches.cs;$(HookProjet)Echange.cs;$(HookProjet)hook.csproj;$(MSBuildThisFileDirectory)Trinite\EtatsEnDirect.cs;$(MSBuildThisFileDirectory)Trinite\Connecteurs.cs" Outputs="$(HookSortie)nexuskeypad-hook.exe"
          Condition="'$(Edition)' != 'Poste'">
    <Exec Command="set &quot;PATH=$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer;%PATH%&quot; &amp;&amp; dotnet publish &quot;$(HookProjet)hook.csproj&quot; -c Release -nologo -v q -o &quot;$(HookSortie.TrimEnd('\'))&quot;"
          EnvironmentVariables="DOTNET_CLI_TELEMETRY_OPTOUT=1" />
  </Target>
  <Target Name="HookCopie" AfterTargets="CopyPackage" DependsOnTargets="HookPublie" Condition="'$(Edition)' != 'Poste'">
    <Copy SourceFiles="$(HookSortie)nexuskeypad-hook.exe" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <!-- The signed package carries the same verified service lifecycle used by get.ps1 and source installation. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\get.ps1" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <!-- Mod du quota exact de Claude et son catalogue local, posés avec les hooks (EtatsEnDirect). -->
    <ItemGroup>
      <ModsClaude Include="$(MSBuildThisFileDirectory)..\..\claude-quota\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModsClaude)" DestinationFolder="$(OutputPath)claude-quota\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <ConnecteursPad Include="$(MSBuildThisFileDirectory)..\..\connecteurs\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ConnecteursPad)" DestinationFolder="$(OutputPath)connecteurs\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- test.ps1 compile avec NexusTest=true : ni lien posé, ni rechargement du plugin en service. -->
  <!-- Installé comme un vrai paquet (Plugins\TrinitePad), pas par un lien .link : avec le lien, le service ne chargeait
       pas le plugin quand Logi démarrait avec Windows (pad sur le logo Logi) ; le paquet se charge toujours. -->
  <!-- Garde-fou (règle du 25/10, après un essai qui a touché le vrai dossier des plugins) : la compilation n'installe dans
       le vrai dossier de Logi qu'avec -p:Reel=true, sur l'accord de l'utilisateur. -->
  <!-- Le pad de l'utilisateur tourne sur l'édition NexusKeypad depuis le 26/10 : une autre édition installée à côté
       ferait tourner deux moteurs (même tube d'essais). -->
  <Target Name="ReelNexus" BeforeTargets="Build" Condition="'$(NexusTest)' != 'true' And '$(Reel)' == 'true' And '$(Edition)' != 'Nexus'">
    <Error Text="-p:Reel=true installe le plugin du pad : ajouter -p:Edition=Nexus (édition NexusKeypad, celle du pad)." />
  </Target>
  <Target Name="PostBuild" AfterTargets="CopyPackage" Condition="'$(NexusTest)' != 'true' And '$(Reel)' == 'true'">
    <ItemGroup>
      <Paquet Include="$(BaseOutputPath)$(Configuration)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(Paquet)" DestinationFolder="$(PluginDir)$(PluginShortName)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Delete Files="$(PluginDir)$(ProjectName).link" />
    <!-- Pas d'ordre « reload » : Logi surveille ce dossier et recharge déjà le plugin à la copie ; l'ordre en plus le
         chargeait deux fois (deux moteurs, tube du pilote pris, 23/10). -->
  </Target>

  <Target Name="PluginClean" AfterTargets="CoreClean">
    <Delete Files="$(PluginDir)$(ProjectName).link" Condition="'$(NexusTest)' != 'true' And '$(Reel)' == 'true'" />
    <RemoveDir Directories="$(PluginDir)$(PluginShortName)\" Condition="'$(NexusTest)' != 'true' And '$(Reel)' == 'true'" />
    <RemoveDir Directories="$(OutputPath)..\" />
  </Target>

</Project>
