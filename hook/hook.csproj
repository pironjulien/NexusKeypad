<Project Sdk="Microsoft.NET.Sdk">

  <!-- Écrivain d'état des hooks de Claude et d'Antigravity, sans Python : un exécutable natif (Native AOT, aucun
       runtime .NET à installer, démarrage en quelques millisecondes) livré dans le paquet du plugin. Mêmes règles que
       etat/etat.py, tenues à l'identique par tests/test_etat.py. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>nexuskeypad-hook</AssemblyName>
    <RootNamespace>NexusKeypad.Hook</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <BaseOutputPath>$(LocalAppData)\NexusKeypad\hook-build\bin\</BaseOutputPath>
  </PropertyGroup>

</Project>
