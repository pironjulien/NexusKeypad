<Project Sdk="Microsoft.NET.Sdk">

  <!-- Écrivain d'état des hooks de Claude et d'Antigravity, sans Python : un exécutable natif (Native AOT, aucun
       runtime .NET à installer, démarrage en quelques millisecondes) livré dans le paquet du plugin. Règles tenues
       cas par cas par tests/Hook. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>nexuskeypad-hook</AssemblyName>
    <RootNamespace>NexusKeypad.Hook</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Recommended .NET analyzers and the build-time code-style rules of .editorconfig, all errors (as the plugin). -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The two packages below are pinned on purpose (see there): their "delete explicit reference" notice is answered. -->
    <SuppressGenerateILCompilerExplicitPackageReferenceWarning>true</SuppressGenerateILCompilerExplicitPackageReferenceWarning>
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
  </PropertyGroup>

  <ItemGroup>
    <!-- The AOT compiler and the trimmer, pinned like any package (packages.lock.json, Dependabot): left implicit, their
         version would follow the .NET SDK of the machine and break the locked restore whenever the CI's SDK moves. -->
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.15" />
  </ItemGroup>

  <!-- Argument « remove » (get.ps1 -Remove) : le retrait des états en direct, le même code que l'action « Live states ». -->
  <ItemGroup>
    <EmbeddedResource Include="assets\antigravity.wav" LogicalName="NexusKeypad.Hook.antigravity.wav" />
    <EmbeddedResource Include="assets\claude.wav" LogicalName="NexusKeypad.Hook.claude.wav" />
    <Compile Include="..\plugin\src\Trinite\EtatsEnDirect.cs" />
    <Compile Include="..\plugin\src\Trinite\Connecteurs.cs" />
    <PackageReference Include="Tomlyn" Version="2.10.2" />
  </ItemGroup>

</Project>
