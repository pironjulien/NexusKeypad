<Project>
  <!-- Every build of the repository goes outside OneDrive, under ~/.nexus/build/nexuskeypad (imported by the
       Directory.Build.props of plugin/src, hook, apercu and tests). The user profile comes from .NET, not $(USERPROFILE):
       Dependabot restores on Linux, where USERPROFILE is unset and '/.nexus' at the file system root was denied, so its
       NuGet updates silently found nothing. Paths are combined by .NET, without hard-coded separators. -->
  <PropertyGroup>
    <NexusKeypadBuild>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::Combine($([System.Environment]::GetFolderPath(SpecialFolder.UserProfile)), '.nexus', 'build', 'nexuskeypad'))))</NexusKeypadBuild>
  </PropertyGroup>

  <!-- NuGet restore pinned by packages.lock.json (direct and transitive packages, content hashes); CI and release
       restore in locked mode, so a dependency never changes without a committed lock file. The projects whose packages
       depend on the machine (Logi service installed or not) opt out in their own file. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Without the Logi service (CI), the LogiPluginApi package pulls in the StyleCop analyzers (absent locally): they are
       left out of every project, so the same analysis gate runs locally and in CI. -->
  <Target Name="SansStyleCop" AfterTargets="ResolveLockFileAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'StyleCop.Analyzers'" />
    </ItemGroup>
  </Target>
</Project>
