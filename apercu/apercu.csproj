<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aperçu hors du pad : dessine les 9 touches dans plusieurs états en planches PNG. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- La rigueur du plugin : analyseurs .NET recommandés, chaque avertissement une erreur (les analyseurs StyleCop du
         paquet LogiPluginApi en CI sont retirés par le Directory.Build.props de la racine). -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <LogiService>C:\Program Files\Logi\LogiPluginService\</LogiService>
    <!-- No packages.lock.json: the packages differ by machine (LogiPluginApi only without the Logi service, as in CI),
         so no single lock file can hold for both. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\plugin\src\Trinite\*.cs" />
    <Compile Include="..\plugin\src\Helpers\PluginLog.cs" />
    <PackageReference Include="Tomlyn" Version="2.10.2" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(LogiService)PluginApi.dll')">
    <Reference Include="PluginApi" HintPath="$(LogiService)PluginApi.dll" />
    <Reference Include="SkiaSharp" HintPath="$(LogiService)SkiaSharp.dll" />
  </ItemGroup>

  <!-- Sans service Logi (intégration continue) : l'API publiée par Logitech et ses dépendances (SkiaSharp 2.88.8). -->
  <ItemGroup Condition="!Exists('$(LogiService)PluginApi.dll')">
    <PackageReference Include="LogiPluginApi" Version="6.4.2.3567" />
  </ItemGroup>

</Project>
